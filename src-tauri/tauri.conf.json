{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyxel Nebula",
  "version": "../package.json",
  "identifier": "vn.ai.zyxel.nebula",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://nebula.zyxel.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Zyxel Nebula Control Center",
    "longDescription": "Ứng dụng chuyên dụng truy cập Zyxel Nebula (https://nebula.zyxel.com).",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
